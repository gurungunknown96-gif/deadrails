if game.PlaceId ~= 116495829188952 then
    warn("[RivoHub] Wrong game. PlaceId: " .. tostring(game.PlaceId))
    return
end

local VALID_KEY = "yeasdagdbwo127sbj"
local DISCORD_LINK = "https://discord.gg/ZN4jtyPNHG"

local function copyToClipboard(t)
    if typeof(setclipboard) == "function" then pcall(setclipboard, t); return true end
    return false
end

local function showKeyUI(onSuccess)
    local PlayerGui = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")
    for _, old in ipairs(PlayerGui:GetChildren()) do
        if old.Name == "RivoKeySystem" then old:Destroy() end
    end

    local KeyGui = Instance.new("ScreenGui")
    KeyGui.Name = "RivoKeySystem"
    KeyGui.ResetOnSpawn = false
    KeyGui.IgnoreGuiInset = true
    KeyGui.DisplayOrder = 999999
    KeyGui.Parent = PlayerGui

    local Blur = Instance.new("Frame")
    Blur.Size = UDim2.new(1,0,1,0)
    Blur.BackgroundColor3 = Color3.fromRGB(0,0,0)
    Blur.BackgroundTransparency = 0.45
    Blur.BorderSizePixel = 0
    Blur.Parent = KeyGui

    local Main = Instance.new("Frame")
    Main.Size = UDim2.fromOffset(440, 310)
    Main.Position = UDim2.new(0.5,-220,0.5,-155)
    Main.BackgroundColor3 = Color3.fromRGB(10,10,14)
    Main.BorderSizePixel = 0
    Main.Parent = KeyGui
    Instance.new("UICorner", Main).CornerRadius = UDim.new(0,14)

    local Accent = Instance.new("Frame")
    Accent.Size = UDim2.new(1,0,0,3)
    Accent.BackgroundColor3 = Color3.fromRGB(180,0,255)
    Accent.BorderSizePixel = 0
    Accent.Parent = Main
    Instance.new("UICorner", Accent).CornerRadius = UDim.new(0,3)

    local function label(text, size, color, y, bold)
        local l = Instance.new("TextLabel")
        l.Size = UDim2.new(1,-40,0,24)
        l.Position = UDim2.new(0,20,0,y)
        l.BackgroundTransparency = 1
        l.Text = text
        l.TextColor3 = color or Color3.fromRGB(220,220,220)
        l.TextSize = size or 14
        l.Font = bold and Enum.Font.GothamBlack or Enum.Font.Gotham
        l.TextXAlignment = Enum.TextXAlignment.Left
        l.Parent = Main
        return l
    end

    label("RIVO HUB", 22, Color3.fromRGB(180,0,255), 16, true)
    label("Dead Rails | Key Required", 12, Color3.fromRGB(140,140,160), 44, false)

    local GetKeyBtn = Instance.new("TextButton")
    GetKeyBtn.Size = UDim2.fromOffset(180,36)
    GetKeyBtn.Position = UDim2.new(0,20,0,84)
    GetKeyBtn.BackgroundColor3 = Color3.fromRGB(30,0,60)
    GetKeyBtn.TextColor3 = Color3.fromRGB(180,0,255)
    GetKeyBtn.Text = "Get Key (Discord)"
    GetKeyBtn.Font = Enum.Font.GothamBold
    GetKeyBtn.TextSize = 12
    GetKeyBtn.BorderSizePixel = 0
    GetKeyBtn.Parent = Main
    Instance.new("UICorner", GetKeyBtn).CornerRadius = UDim.new(0,8)

    local CopiedLabel = Instance.new("TextLabel")
    CopiedLabel.Size = UDim2.fromOffset(220,20)
    CopiedLabel.Position = UDim2.new(0,210,0,92)
    CopiedLabel.BackgroundTransparency = 1
    CopiedLabel.Text = ""
    CopiedLabel.TextColor3 = Color3.fromRGB(0,220,120)
    CopiedLabel.Font = Enum.Font.Gotham
    CopiedLabel.TextSize = 11
    CopiedLabel.TextXAlignment = Enum.TextXAlignment.Left
    CopiedLabel.Parent = Main

    GetKeyBtn.MouseButton1Click:Connect(function()
        if copyToClipboard(DISCORD_LINK) then
            CopiedLabel.Text = "✔ Copied Discord link"
        else
            CopiedLabel.Text = DISCORD_LINK
        end
        task.delay(3, function() CopiedLabel.Text = "" end)
    end)

    label("Enter Key:", 13, Color3.fromRGB(180,180,200), 136, false)

    local KeyBox = Instance.new("TextBox")
    KeyBox.Size = UDim2.new(1,-40,0,38)
    KeyBox.Position = UDim2.new(0,20,0,160)
    KeyBox.BackgroundColor3 = Color3.fromRGB(20,20,28)
    KeyBox.TextColor3 = Color3.new(1,1,1)
    KeyBox.PlaceholderText = "Paste your key here..."
    KeyBox.PlaceholderColor3 = Color3.fromRGB(80,80,100)
    KeyBox.Text = ""
    KeyBox.Font = Enum.Font.Code
    KeyBox.TextSize = 13
    KeyBox.ClearTextOnFocus = false
    KeyBox.BorderSizePixel = 0
    KeyBox.Parent = Main
    Instance.new("UICorner", KeyBox).CornerRadius = UDim.new(0,8)
    local stroke = Instance.new("UIStroke", KeyBox)
    stroke.Color = Color3.fromRGB(80,0,160)
    stroke.Thickness = 1.5

    local SubmitBtn = Instance.new("TextButton")
    SubmitBtn.Size = UDim2.new(1,-40,0,38)
    SubmitBtn.Position = UDim2.new(0,20,0,210)
    SubmitBtn.BackgroundColor3 = Color3.fromRGB(140,0,220)
    SubmitBtn.TextColor3 = Color3.new(1,1,1)
    SubmitBtn.Text = "Submit Key"
    SubmitBtn.Font = Enum.Font.GothamBold
    SubmitBtn.TextSize = 13
    SubmitBtn.BorderSizePixel = 0
    SubmitBtn.Parent = Main
    Instance.new("UICorner", SubmitBtn).CornerRadius = UDim.new(0,8)

    local StatusLabel = Instance.new("TextLabel")
    StatusLabel.Size = UDim2.new(1,-40,0,30)
    StatusLabel.Position = UDim2.new(0,20,0,258)
    StatusLabel.BackgroundTransparency = 1
    StatusLabel.Text = ""
    StatusLabel.TextColor3 = Color3.fromRGB(255,80,80)
    StatusLabel.Font = Enum.Font.Gotham
    StatusLabel.TextSize = 11
    StatusLabel.TextWrapped = true
    StatusLabel.Parent = Main

    local function trySubmit()
        local entered = KeyBox.Text:gsub("%s+","")
        if entered == "" then
            StatusLabel.TextColor3 = Color3.fromRGB(255,80,80)
            StatusLabel.Text = "Enter a key"
            return
        end
        if entered == VALID_KEY then
            KeyGui:Destroy()
            onSuccess()
        else
            stroke.Color = Color3.fromRGB(255,40,40)
            StatusLabel.TextColor3 = Color3.fromRGB(255,80,80)
            StatusLabel.Text = "Invalid key"
            KeyBox.Text = ""
            task.delay(2, function()
                stroke.Color = Color3.fromRGB(80,0,160)
                StatusLabel.Text = ""
            end)
        end
    end

    SubmitBtn.MouseButton1Click:Connect(trySubmit)
    KeyBox.FocusLost:Connect(function(enter) if enter then trySubmit() end end)
end

local function loadHub()
    local PlayerGui = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")
    for _, obj in ipairs(PlayerGui:GetChildren()) do
        if obj:IsA("ScreenGui") then
            if obj.Name ~= "RivoKeySystem" and (obj.Name:find("WindUI") or obj.Name:find("Rivo")) then
                pcall(function() obj:Destroy() end)
            end
        end
    end
    if typeof(getgenv) == "function" then
        pcall(function()
            if getgenv().WindUI and getgenv().WindUI.Destroy then
                getgenv().WindUI:Destroy()
            end
        end)
        pcall(function() getgenv().WindUI = nil end)
    end

    local ok, WindUI = pcall(function()
        return loadstring(game:HttpGet("https://github.com/Footagesus/WindUI/releases/latest/download/main.lua"))()
    end)
    if not ok or not WindUI then
        warn("[RivoHub] WindUI failed to load: " .. tostring(WindUI))
        return
    end

    local RS          = game:GetService("ReplicatedStorage")
    local Players     = game:GetService("Players")
    local RunService  = game:GetService("RunService")
    local UIS         = game:GetService("UserInputService")
    local Workspace   = game:GetService("Workspace")
    local Lighting    = game:GetService("Lighting")
    local LocalPlayer = Players.LocalPlayer
    local Camera      = Workspace.CurrentCamera

    local world, comps, replicator, Remotes, Event
    pcall(function()
        world      = require(RS.Shared.Universe.ECS.world)
        comps      = require(RS.Shared.Universe.ECS.components)
        replicator = require(RS.Client.Universe.Replication.clientReplicator)
        Remotes    = require(RS.Shared.Universe.Remotes)
        Event      = RS.Shared.Universe.Network.RemoteEvent.Actionable
    end)

    local S = {
        autoBond=false, autoFarm=false,
        aimbot=false, aimbotFOV=200, aimbotSmooth=0.4, aimbotPart="Head", aimbotConn=nil,
        silentAim=false, silentAimConn=nil,
        triggerBot=false, triggerBotFOV=30, triggerBotConn=nil,
        meleeAura=false, meleeAuraConn=nil, meleeDist=15,
        autoParry=false, autoParryConn=nil,
        itemESP=false, enemyESP=false, playerESP=false,
        itemESPColor=Color3.fromRGB(255,80,80),
        enemyESPColor=Color3.fromRGB(255,45,120),
        playerESPColor=Color3.fromRGB(70,200,255),
        espObjects={}, espConns={},
        crosshair=false, crosshairGui=nil,
        crosshairColor=Color3.fromRGB(255,45,120),
        crosshairSize=10, crosshairThickness=2, crosshairGap=4, crosshairMode="Cross",
        showFOV=false, fovCircle=nil,
        fly=false, flyBV=nil, flyBG=nil, flySpeed=80, flyConn=nil,
        speedHack=false, speedValue=50, speedConn=nil,
        jumpBoost=false, jumpValue=150, jumpConn=nil,
        infiniteJump=false, infJumpConn=nil,
        noclip=false, noclipConn=nil,
        invisible=false, invisConn=nil,
        silentWalk=false, silentWalkOrig=nil,
        fullBright=false, origAmbient=nil, origOutdoor=nil, origBrightness=nil,
        thirdPerson=false,
        antiAFK=false, antiAFKConn=nil,
        godMode=false, godModeConn=nil,
        cursorGui=nil, cursorRenderConn=nil,
        cursorColor=Color3.fromRGB(180,0,255),
        cursorSize=20, cursorMode="Arrow",
        customCursor=false, hideDefaultCursor=false,
        savedPos=nil,
        itemMagnet=false, magnetConn=nil, magnetRange=25,
        spinBot=false, spinConn=nil,
        tracers=false, tracerGui=nil, tracerConn=nil,
        chamObjects={},
    }

    local function notify(t,c,i,d)
        WindUI:Notify({Title=t, Content=c, Icon=i or "info", Duration=d or 3})
    end
    local function getChar() return LocalPlayer.Character end
    local function getHRP() local c=getChar() return c and c:FindFirstChild("HumanoidRootPart") end
    local function getHum() local c=getChar() return c and c:FindFirstChildOfClass("Humanoid") end
    local function disconnect(conn)
        if conn then pcall(function() conn:Disconnect() end) end
        return nil
    end

    local function isNPC(m)
        if not m or not m:IsA("Model") then return false end
        local h = m:FindFirstChildOfClass("Humanoid")
        if not h or h.Health <= 0 then return false end
        if Players:GetPlayerFromCharacter(m) then return false end
        return m:FindFirstChild("Head") ~= nil or m:FindFirstChild("HumanoidRootPart") ~= nil
    end

    local function getTargetPart(npc, part)
        if part == "Head" then return npc:FindFirstChild("Head") end
        if part == "Torso" then return npc:FindFirstChild("UpperTorso") or npc:FindFirstChild("Torso") end
        return npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChild("Head")
    end

    local function closestNPCScreen(maxFOV, part)
        local hrp = getHRP(); if not hrp then return nil end
        local center = Camera.ViewportSize / 2
        local best, bestDist = nil, math.huge
        for _, m in ipairs(Workspace:GetDescendants()) do
            if isNPC(m) then
                local p = getTargetPart(m, part or "Head")
                if p then
                    local sp, on = Camera:WorldToViewportPoint(p.Position)
                    if on then
                        local sd = (Vector2.new(sp.X,sp.Y) - center).Magnitude
                        if sd < (maxFOV or math.huge) and sd < bestDist then bestDist = sd; best = m end
                    end
                end
            end
        end
        return best
    end

    local function closestNPCDist(maxDist)
        local hrp = getHRP(); if not hrp then return nil end
        local best, bestDist = nil, maxDist or 15
        for _, m in ipairs(Workspace:GetDescendants()) do
            if isNPC(m) then
                local root = m:FindFirstChild("HumanoidRootPart") or m:FindFirstChild("Head")
                if root then
                    local d = (root.Position - hrp.Position).Magnitude
                    if d < bestDist then bestDist = d; best = m end
                end
            end
        end
        return best
    end

    local function makeFOVCircle()
        if S.fovCircle then S.fovCircle:Destroy(); S.fovCircle = nil end
        local sg = Instance.new("ScreenGui")
        sg.Name="RivoFOV"; sg.ResetOnSpawn=false; sg.IgnoreGuiInset=true; sg.Parent=PlayerGui
        local f = Instance.new("Frame")
        f.Size = UDim2.new(0, S.aimbotFOV*2, 0, S.aimbotFOV*2)
        f.Position = UDim2.new(0.5, -S.aimbotFOV, 0.5, -S.aimbotFOV)
        f.BackgroundTransparency = 1; f.Parent = sg
        Instance.new("UICorner", f).CornerRadius = UDim.new(1,0)
        local st = Instance.new("UIStroke", f)
        st.Color = Color3.fromRGB(180,0,255); st.Thickness = 1.5; st.Transparency = 0.3
        S.fovCircle = sg
    end

    local function makeCrosshair()
        if S.crosshairGui then S.crosshairGui:Destroy(); S.crosshairGui = nil end
        local sg = Instance.new("ScreenGui")
        sg.Name="RivoCrosshair"; sg.ResetOnSpawn=false; sg.IgnoreGuiInset=true
        sg.DisplayOrder=999; sg.Parent=PlayerGui
        local sz,th,gp,col = S.crosshairSize,S.crosshairThickness,S.crosshairGap,S.crosshairColor
        local function line(pos, size)
            local f = Instance.new("Frame")
            f.Size=size; f.Position=pos; f.BackgroundColor3=col; f.BorderSizePixel=0; f.Parent=sg
        end
        if S.crosshairMode=="Cross" or S.crosshairMode=="Both" then
            line(UDim2.new(0.5,-th/2,0.5,-sz-gp), UDim2.new(0,th,0,sz))
            line(UDim2.new(0.5,-th/2,0.5,gp),     UDim2.new(0,th,0,sz))
            line(UDim2.new(0.5,-sz-gp,0.5,-th/2), UDim2.new(0,sz,0,th))
            line(UDim2.new(0.5,gp,0.5,-th/2),     UDim2.new(0,sz,0,th))
        end
        if S.crosshairMode=="Dot" or S.crosshairMode=="Both" then
            local dot = Instance.new("Frame")
            dot.Size = UDim2.new(0,th+2,0,th+2)
            dot.Position = UDim2.new(0.5,-(th+2)/2,0.5,-(th+2)/2)
            dot.BackgroundColor3 = col; dot.BorderSizePixel = 0; dot.Parent = sg
            Instance.new("UICorner", dot).CornerRadius = UDim.new(1,0)
        end
        if S.crosshairMode=="Circle" then
            local c = Instance.new("Frame")
            c.Size = UDim2.new(0,sz*2,0,sz*2)
            c.Position = UDim2.new(0.5,-sz,0.5,-sz)
            c.BackgroundTransparency = 1; c.Parent = sg
            Instance.new("UICorner", c).CornerRadius = UDim.new(1,0)
            local st = Instance.new("UIStroke", c); st.Color = col; st.Thickness = th
        end
        S.crosshairGui = sg
    end

    local function makeCursor()
        if S.cursorGui then S.cursorGui:Destroy(); S.cursorGui = nil end
        S.cursorRenderConn = disconnect(S.cursorRenderConn)
        local sg = Instance.new("ScreenGui")
        sg.Name="RivoCursor"; sg.ResetOnSpawn=false; sg.IgnoreGuiInset=true
        sg.DisplayOrder=100000; sg.Parent=PlayerGui
        local container = Instance.new("Frame")
        container.Size=UDim2.new(0,60,0,60); container.BackgroundTransparency=1; container.Parent=sg
        local frame = Instance.new("Frame")
        frame.Size=UDim2.new(0,S.cursorSize,0,S.cursorSize)
        frame.Position=UDim2.new(0,10,0,10); frame.BackgroundTransparency=1; frame.Parent=container
        local col = S.cursorColor
        if S.cursorMode=="Arrow" then
            local a=Instance.new("Frame"); a.Size=UDim2.new(1,0,1,0)
            a.BackgroundColor3=col; a.BackgroundTransparency=0.1; a.BorderSizePixel=0; a.Parent=frame
            Instance.new("UICorner", a).CornerRadius = UDim.new(0,5)
        elseif S.cursorMode=="Circle" then
            local c=Instance.new("Frame"); c.Size=UDim2.new(1,0,1,0)
            c.BackgroundTransparency=1; c.Parent=frame
            Instance.new("UICorner", c).CornerRadius=UDim.new(1,0)
            local st=Instance.new("UIStroke", c); st.Color=col; st.Thickness=2
            local dot=Instance.new("Frame"); dot.Size=UDim2.new(0,4,0,4)
            dot.Position=UDim2.new(0.5,-2,0.5,-2); dot.BackgroundColor3=col; dot.BorderSizePixel=0; dot.Parent=frame
            Instance.new("UICorner", dot).CornerRadius=UDim.new(1,0)
        elseif S.cursorMode=="Crosshair" then
            local function l(p,s) local f=Instance.new("Frame") f.Size=s f.Position=p f.BackgroundColor3=col f.BorderSizePixel=0 f.Parent=frame end
            l(UDim2.new(0.5,-1,0,0), UDim2.new(0,2,0,S.cursorSize))
            l(UDim2.new(0,0,0.5,-1), UDim2.new(0,S.cursorSize,0,2))
        elseif S.cursorMode=="Dot" then
            local d=Instance.new("Frame"); d.Size=UDim2.new(1,0,1,0)
            d.BackgroundColor3=col; d.BorderSizePixel=0; d.Parent=frame
            Instance.new("UICorner", d).CornerRadius=UDim.new(1,0)
        end
        S.cursorRenderConn = RunService.RenderStepped:Connect(function()
            if not S.customCursor then return end
            local mp = UIS:GetMouseLocation()
            container.Position = UDim2.new(0, mp.X-10, 0, mp.Y-10)
        end)
        S.cursorGui = sg
    end

    local function clearESP()
        for _, obj in ipairs(S.espObjects) do pcall(function() if obj and obj.Parent then obj:Destroy() end end) end
        for _, c in ipairs(S.espConns) do pcall(function() c:Disconnect() end) end
        S.espObjects = {}; S.espConns = {}
    end

    local function buildESP()
        clearESP()
        if S.itemESP then
            local items = Workspace:FindFirstChild("RuntimeItems")
            if items then
                for _, m in ipairs(items:GetDescendants()) do
                    if m:IsA("Model") and m.PrimaryPart then
                        local bb = Instance.new("BillboardGui")
                        bb.Adornee=m.PrimaryPart; bb.AlwaysOnTop=true
                        bb.Size=UDim2.new(0,140,0,28); bb.StudsOffset=Vector3.new(0,2.5,0)
                        bb.Parent=PlayerGui
                        local lbl=Instance.new("TextLabel", bb)
                        lbl.Size=UDim2.new(1,0,1,0); lbl.BackgroundTransparency=1
                        lbl.Text="📦 "..m.Name; lbl.TextColor3=S.itemESPColor
                        lbl.TextStrokeTransparency=0; lbl.Font=Enum.Font.GothamBold; lbl.TextSize=11
                        table.insert(S.espObjects, bb)
                    end
                end
            end
        end
        local function addEntityBB(target, prefix, colr, isPlayer)
            local head = target:FindFirstChild("Head") or target:FindFirstChild("HumanoidRootPart")
            local hum = target:FindFirstChildOfClass("Humanoid")
            if not (head and hum) then return end
            local bb=Instance.new("BillboardGui")
            bb.Adornee=head; bb.AlwaysOnTop=true
            bb.Size=UDim2.new(0,160,0,52); bb.StudsOffset=Vector3.new(0,3,0); bb.Parent=PlayerGui
            local bg=Instance.new("Frame", bb); bg.Size=UDim2.new(1,0,1,0)
            bg.BackgroundColor3=Color3.new(0,0,0); bg.BackgroundTransparency=0.4; bg.BorderSizePixel=0
            Instance.new("UICorner", bg).CornerRadius=UDim.new(0,7)
            local nL=Instance.new("TextLabel", bg); nL.Size=UDim2.new(1,-6,0,20); nL.Position=UDim2.new(0,3,0,2)
            nL.BackgroundTransparency=1; nL.Text=prefix..target.Name
            nL.TextColor3=colr; nL.TextStrokeTransparency=0
            nL.Font=Enum.Font.GothamBlack; nL.TextSize=11
            local hpL=Instance.new("TextLabel", bg); hpL.Size=UDim2.new(1,-6,0,14); hpL.Position=UDim2.new(0,3,0,24)
            hpL.BackgroundTransparency=1; hpL.TextColor3=Color3.fromRGB(0,220,120)
            hpL.TextStrokeTransparency=0; hpL.Font=Enum.Font.GothamBold; hpL.TextSize=9
            local distL=Instance.new("TextLabel", bg); distL.Size=UDim2.new(1,-6,0,12); distL.Position=UDim2.new(0,3,0,38)
            distL.BackgroundTransparency=1; distL.TextColor3=Color3.fromRGB(180,180,220)
            distL.TextStrokeTransparency=0; distL.Font=Enum.Font.Gotham; distL.TextSize=9
            table.insert(S.espObjects, bb)
            local conn
            conn = RunService.RenderStepped:Connect(function()
                if not bb.Parent then conn:Disconnect(); return end
                if isPlayer and not S.playerESP then return end
                if (not isPlayer) and not S.enemyESP then return end
                if hum then hpL.Text = "❤ "..math.floor(hum.Health).." / "..math.floor(hum.MaxHealth) end
                local hrp = getHRP()
                if hrp and head then distL.Text = "📍 "..math.floor((head.Position - hrp.Position).Magnitude).." studs" end
            end)
            table.insert(S.espConns, conn)
        end
        if S.enemyESP then
            for _, m in ipairs(Workspace:GetDescendants()) do
                if isNPC(m) then addEntityBB(m, "👻 ", S.enemyESPColor, false) end
            end
        end
        if S.playerESP then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then addEntityBB(p.Character, "👤 ", S.playerESPColor, true) end
            end
        end
    end

    local function startTracers()
        if S.tracerGui then S.tracerGui:Destroy() end
        local sg = Instance.new("ScreenGui")
        sg.Name="RivoTracers"; sg.ResetOnSpawn=false; sg.IgnoreGuiInset=true
        sg.DisplayOrder=50; sg.Parent=PlayerGui
        S.tracerGui = sg
        S.tracerConn = disconnect(S.tracerConn)
        S.tracerConn = RunService.RenderStepped:Connect(function()
            for _, c in ipairs(sg:GetChildren()) do c:Destroy() end
            if not S.tracers then return end
            local center = Camera.ViewportSize / 2
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    local head = p.Character:FindFirstChild("Head")
                    if head then
                        local sp, on = Camera:WorldToViewportPoint(head.Position)
                        if on then
                            local line = Instance.new("Frame")
                            line.BackgroundColor3 = S.playerESPColor
                            line.BorderSizePixel = 0; line.Parent = sg
                            local dx, dy = sp.X - center.X, sp.Y - center.Y
                            local len = math.sqrt(dx*dx + dy*dy)
                            line.Size = UDim2.new(0, len, 0, 1.5)
                            line.Position = UDim2.new(0, center.X, 0, center.Y)
                            line.Rotation = math.deg(math.atan2(dy, dx))
                            Instance.new("UICorner", line).CornerRadius = UDim.new(0,1)
                        end
                    end
                end
            end
        end)
    end

    local function stopTracers()
        S.tracerConn = disconnect(S.tracerConn)
        if S.tracerGui then S.tracerGui:Destroy(); S.tracerGui = nil end
    end

    local Window = WindUI:CreateWindow({
        Title="Rivo Hub", Icon="skull", Author="Dead Rails",
        Folder="RivoHub", Size=UDim2.fromOffset(600,440),
        Transparent=true, Theme="Dark", SideBarWidth=195,
        HideSearchBar=false, ScrollBarEnabled=true,
        User={Enabled=true, Anonymous=false}, KeySystem=false,
    })

    local FarmTab = Window:Tab({Title="Farm", Icon="wheat"})
    local FS = FarmTab:Section({Title="Auto Farm", Opened=true, Box=true, BoxBorder=true})

    FS:Toggle({Title="Auto Bond Farm", Desc="ECS bond collect loop", Value=false, Callback=function(v)
        S.autoBond = v
        if v then
            if not (world and comps and replicator and Remotes and Event) then
                notify("Error", "ECS modules not found", "alert-triangle") return
            end
            task.spawn(function()
                while S.autoBond do
                    pcall(function()
                        local char = world:get_resource(comps.ClientStateResource).localCharacter
                        if char then
                            if not world:has(char, comps.Sack) then
                                world:add(char, comps.Sack)
                                world:set(char, comps.Sack, {contents={}, maxContents=10})
                            end
                            for id=1,100000 do
                                if world:has(id, comps.Storable) and world:get(id, comps.ObjectId)=="bond" then
                                    local sr = replicator:get_server_entity(id)
                                    if sr and sr~=id then
                                        Remotes.Store:FireServer(sr)
                                        Event:FireServer(sr)
                                    end
                                end
                            end
                        end
                    end)
                    task.wait(1)
                end
            end)
            notify("Auto Bond", "Running", "check")
        else notify("Auto Bond", "Stopped", "x") end
    end})

    FS:Toggle({Title="Auto Farm (Actionable)", Value=false, Callback=function(v)
        S.autoFarm = v
        if v then
            task.spawn(function()
                while S.autoFarm do
                    for id=1300,9000 do
                        if not S.autoFarm then break end
                        pcall(function() if Event then Event:FireServer(id) end end)
                        task.wait(0.02)
                    end
                    task.wait(0.4)
                end
            end)
            notify("Auto Farm", "Running", "check")
        else notify("Auto Farm", "Stopped", "x") end
    end})

    FS:Toggle({Title="Item Magnet", Value=false, Callback=function(v)
        S.itemMagnet = v
        S.magnetConn = disconnect(S.magnetConn)
        if v then
            S.magnetConn = RunService.Heartbeat:Connect(function()
                if not S.itemMagnet then return end
                local hrp = getHRP(); if not hrp then return end
                local items = Workspace:FindFirstChild("RuntimeItems"); if not items then return end
                for _, m in ipairs(items:GetDescendants()) do
                    if m:IsA("Model") and m.PrimaryPart then
                        if (m.PrimaryPart.Position - hrp.Position).Magnitude <= S.magnetRange then
                            pcall(function() m:SetPrimaryPartCFrame(hrp.CFrame + hrp.CFrame.LookVector * 3) end)
                        end
                    end
                end
            end)
            notify("Item Magnet", "Active", "magnet")
        else notify("Item Magnet", "Off", "x") end
    end})

