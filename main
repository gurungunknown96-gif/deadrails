                if not S.godMode then return end
                local h = getHum()
                if h then h.MaxHealth = math.huge; h.Health = math.huge end
            end)
            notify("God Mode", "On", "shield")
        else
            local h = getHum()
            if h then h.MaxHealth = 100; h.Health = 100 end
            notify("God Mode", "Off", "x")
        end
    end})
    US:Toggle({Title="Spin Bot", Value=false, Callback=function(v)
        S.spinBot = v
        S.spinConn = disconnect(S.spinConn)
        if v then
            local angle = 0
            S.spinConn = RunService.RenderStepped:Connect(function()
                if not S.spinBot then return end
                local hrp = getHRP()
                if hrp then
                    angle = (angle + 10) % 360
                    hrp.CFrame = CFrame.new(hrp.Position) * CFrame.Angles(0, math.rad(angle), 0)
                end
            end)
        end
    end})
    US:Button({Title="Respawn", Icon="rotate-ccw", Callback=function()
        local h = getHum(); if h then h.Health = 0 end
    end})
    US:Button({Title="Rejoin", Icon="log-out", Callback=function()
        game:GetService("TeleportService"):Teleport(game.PlaceId, LocalPlayer)
    end})
    US:Button({Title="Copy Rivo Discord", Icon="link", Callback=function()
        if copyToClipboard(DISCORD_LINK) then notify("Discord", "Copied!", "link")
        else notify("Discord", DISCORD_LINK, "link") end
    end})

    local SetTab = Window:Tab({Title="Settings", Icon="settings"})
    local SS = SetTab:Section({Title="Config", Opened=true, Box=true, BoxBorder=true})
    SS:Button({Title="Unload Hub", Icon="trash", Callback=function()
        clearESP(); stopTracers()
        for _, obj in ipairs(S.chamObjects) do pcall(function() obj:Destroy() end) end
        S.chamObjects = {}
        if S.crosshairGui then S.crosshairGui:Destroy() end
        if S.cursorGui then S.cursorGui:Destroy() end
        if S.fovCircle then S.fovCircle:Destroy() end
        for _, k in ipairs({"cursorRenderConn","aimbotConn","silentAimConn","triggerBotConn",
            "meleeAuraConn","godModeConn","noclipConn","flyConn","speedConn","jumpConn",
            "infJumpConn","spinConn","invisConn","antiAFKConn","autoParryConn","magnetConn"}) do
            S[k] = disconnect(S[k])
        end
        if S.flyBV then S.flyBV:Destroy() end
        if S.flyBG then S.flyBG:Destroy() end
        local h = getHum()
        if h then h.WalkSpeed = 16; h.JumpPower = 50; h.MaxHealth = 100; h.Health = 100 end
        pcall(function() UIS.MouseIconEnabled = true end)
        Window:Destroy()
        notify("Rivo Hub", "Unloaded", "check")
    end})

    notify("Rivo Hub", "Loaded", "check", 5)
end

showKeyUI(loadHub)
