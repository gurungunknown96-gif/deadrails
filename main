            if p ~= LocalPlayer and p.Character then
                local r = p.Character:FindFirstChild("HumanoidRootPart")
                if r then
                    local d = (r.Position - hrp.Position).Magnitude
                    if d < bestDist then bestDist = d; best = p end
                end
            end
        end
        if best then
            local r = best.Character.HumanoidRootPart
            hrp.CFrame = r.CFrame + r.CFrame.LookVector * 5
            notify("Teleport", "To "..best.Name, "check")
        else notify("Teleport", "No players", "alert-triangle") end
