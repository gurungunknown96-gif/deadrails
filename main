    local CS2 = CombatTab:Section({Title="Silent & Trigger", Opened=true, Box=true, BoxBorder=true})

    CS2:Toggle({Title="Silent Aim", Value=false, Callback=function(v)
        S.silentAim = v
        S.silentAimConn = disconnect(S.silentAimConn)
        if v then
            if typeof(hookmetamethod) ~= "function" then
                notify("Silent Aim", "Executor lacks hookmetamethod", "alert-triangle")
                S.silentAim = false; return
            end
            local hooked = false
            S.silentAimConn = RunService.RenderStepped:Connect(function()
                if not S.silentAim then return end
                if not hooked then
                    hooked = true
                    pcall(function()
                        local old
                        old = hookmetamethod(game, "__namecall", function(self, ...)
                            if getnamecallmethod() == "Raycast" and S.silentAim then
                                local npc = closestNPCScreen(500, "Head")
                                if npc then
                                    local head = getTargetPart(npc, "Head")
                                    if head then
                                        local args = {...}
                                        if args[1] and args[2] then
                                            args[2] = (head.Position - args[1]).Unit * args[2].Magnitude
                                        end
                                        return old(self, table.unpack(args))
                                    end
                                end
                            end
                            return old(self, ...)
                        end)
                    end)
                end
            end)
            notify("Silent Aim", "On", "crosshair")
        else notify("Silent Aim", "Off", "x") end
    end})

    CS2:Toggle({Title="Trigger Bot", Value=false, Callback=function(v)
        S.triggerBot = v
        S.triggerBotConn = disconnect(S.triggerBotConn)
        if v then
            S.triggerBotConn = RunService.Heartbeat:Connect(function()
                if not S.triggerBot then return end
                local center = Camera.ViewportSize / 2
                local ray = Camera:ViewportPointToRay(center.X, center.Y)
                local rp = RaycastParams.new()
                rp.FilterType = Enum.RaycastFilterType.Exclude
                rp.FilterDescendantsInstances = {LocalPlayer.Character or Instance.new("Model")}
                local hit = Workspace:Raycast(ray.Origin, ray.Direction * 500, rp)
                if hit and hit.Instance then
                    local model = hit.Instance:FindFirstAncestorOfClass("Model")
                    if model and isNPC(model) then
                        pcall(function()
                            game:GetService("VirtualInputManager"):SendMouseButtonEvent(0,0,0,true,game,0)
                            task.wait(0.01)
                            game:GetService("VirtualInputManager"):SendMouseButtonEvent(0,0,0,false,game,0)
                        end)
                        task.wait(0.07)
                    end
                end
            end)
            notify("Trigger Bot", "On", "crosshair")
        else notify("Trigger Bot", "Off", "x") end
    end})

